# Public (safe to expose)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=you@yourmail.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only - NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_xxx
NOTIFY_EMAIL=you@yourmail.com

# ---- Admin area (/admin) ----
# Choose a LONG password (16+ characters). Without it the admin area stays locked.
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Any long random text, e.g. 40 random characters (signs the login cookie)
ADMIN_SESSION_SECRET=another-long-random-text

# ---- Optional and NOT needed: server-side OCR via OCR.space (browser OCR is free and built in) ----
OCR_SPACE_API_KEY=
